# Copy this file to .env and edit .env (never commit .env).
#   cp .env.example .env
#
# Docker Compose reads .env automatically from the project folder.
# The Makefile reads it too, so the same values drive both.

# Prefix for container, network and volume names (lakehouse-hello-1, lakehouse_hello-data ...)
COMPOSE_PROJECT_NAME=lakehouse

# Which groups of services to start. Later milestones add: orchestration, sql, streaming.
COMPOSE_PROFILES=core

# Shown on the hello page — proves environment variables reach the container.
LAB_NAME=Iceberg Lakehouse Lab

# Port for the Milestone 0 hello app. 8090 avoids ports later services use.
# Why a variable? If 8090 is taken on someone else's Mac, they change one line here.
HELLO_PORT=8090

# --- Milestone 1: lakehouse services ------------------------------------------
# Lab-only test credentials for the local S3 server (RustFS). Not real AWS keys.
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret-key

# Ports on your Mac. Change one only if `make doctor` says it's taken.
S3_PORT=9000
S3_CONSOLE_PORT=9001
CATALOG_PORT=8181
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
