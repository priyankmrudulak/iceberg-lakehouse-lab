# Copy this file to .env and edit .env (never commit .env).
#   cp .env.example .env
#
# Docker Compose reads .env automatically from the project folder.
# The Makefile reads it too, so the same values drive both.

# Prefix for container, network and volume names (lakehouse-hello-1, lakehouse_hello-data ...)
COMPOSE_PROJECT_NAME=lakehouse

# Which groups of services to start. Later milestones add: orchestration, sql, streaming.
COMPOSE_PROFILES=core

# Shown on the hello page — proves environment variables reach the container.
LAB_NAME=Iceberg Lakehouse Lab

# TODO: pick a free port on your Mac for the hello app, e.g. 8088.
# Why a variable? If 8088 is taken on someone else's Mac, they change one line here.
HELLO_PORT=
